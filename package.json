{
  "name": "watchlight",
  "version": "0.1.0",
  "private": true,
  "description": "Mini-SIEM / SOC Dashboard - Real-time security monitoring made simple",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "dotenv -e .env -- turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "lint": "turbo run lint",
    "test": "vitest run",
    "bench": "dotenv -e .env -- node scripts/bench.mjs",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "dotenv-cli": "^11.1.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
