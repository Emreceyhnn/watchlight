# ----------------------------------------
# Watchlight Environment Variables Configuration
# ----------------------------------------

# Environment Mode
NODE_ENV=development

# Web & API Gateway
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws/stream

# Threat Map basemap tiles (free key: https://carto.com/basemaps)
NEXT_PUBLIC_CARTO_API_KEY=

# Security & Secrets
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=<generate-with-openssl-rand-base64-48>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-base64-48>
INGEST_API_KEY=<generate-with-openssl-rand-hex-32>

# Database (PostgreSQL / Neon)
POSTGRES_USER=watchlight_user
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=watchlight_soc
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/watchlight?schema=public

# In-Memory Cache & Pub/Sub (Redis / Upstash)
REDIS_PASSWORD=<generate-a-strong-password>
REDIS_URL=redis://localhost:6379

# Seed script (zorunlu: NODE_ENV=production iken)
SEED_ADMIN_PASSWORD=<generate-a-strong-password>
SEED_ANALYST_PASSWORD=<generate-a-strong-password>

# Rule Engine Worker Settings
RULE_ENGINE_POLL_INTERVAL_MS=1000
DEFAULT_THROTTLE_WINDOW_SEC=600

# Simulator Settings
SIMULATOR_BURST_RATE=50
